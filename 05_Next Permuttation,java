class Solution {
    void nextPermutation(int[] arr) {
    int i=arr.length-2;
    while(i>=0 && arr[i]>= arr[i+1])
    {
    i--; //finding breaking point
    }
    if(i>=0)
    {
    int j=arr.length-1;
    while(j>=0 && arr[j]<= arr[i])
    j--;
    swap(arr,i,j);
    }
    reverse(arr,i+1);
    }


    public void reverse(int[]n, start)
    {
    int end=n.length-1;
    while(start<end)
    {
    swap(n,start,end);
    start++;
    end--;
    }

    }
    public void swap(int[]n, int i ,int j)
    {
    int temp=n[i];
    n[i]=n[j];
    n[j]=temp;
    }

}
